# API base URL (no trailing slash). Leave empty for mock/local-only mode.
# Production / deploy: set VITE_API_URL when running `npm run build` or `scripts/deploy-frontend.sh`
# (e.g. https://dxxxx.cloudfront.net/api if CloudFront routes /api/* to the ALB).
# VITE_API_URL=https://api.artguard.example.com
